# Copy the upstream docker/.env first, then use these values for the local demo.
COMPOSE_PROFILES=${DOC_ENGINE},${DEVICE},tei-gpu,paddleocr-gpu

# Dedicated host ports avoid collisions with services managed by the default
# Docker daemon. Container-side ports and internal service URLs are unchanged.
SVR_WEB_HTTP_PORT=8989
SVR_WEB_HTTPS_PORT=18443
SVR_HTTP_PORT=19380
ADMIN_SVR_HTTP_PORT=19381
SVR_MCP_PORT=19382
GO_HTTP_PORT=19384
GO_ADMIN_PORT=19383

HF_TOKEN=
HF_HOME=/models/.hf-cache
QWEN_HF_REPO=Qwen/Qwen3.5-9B
QWEN_REVISION=main
QWEN_LOCAL_PATH=/models/qwen3.5-9b
QWEN_SERVED_NAME=qwen3.5-9b
QWEN_API_KEY=local-demo-key

VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=4
VLLM_DTYPE=bfloat16
VLLM_LANGUAGE_MODEL_ONLY=true
VLLM_ENFORCE_EAGER=true
VLLM_GPU_IDS=0,1

TEI_MODEL=BAAI/bge-m3
TEI_HOST=embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_GPU_ID=2

OCR_MODEL=PP-StructureV3
OCR_DEVICE=gpu
OCR_GPU_ID=2
PADDLEOCR_BASE_URL=http://paddleocr:8080
PADDLEOCR_ALGORITHM=PP-StructureV3

# aux-gpu: TEI GPU 2, OCR GPU 2 (default; intentional GPU sharing)
# embedding-gpu: TEI GPU 2, OCR CPU
# ocr-gpu: TEI CPU, OCR GPU 2
# aux-cpu: TEI CPU, OCR CPU
# Run scripts/set-demo-aux-mode.sh after changing this value; Compose cannot
# branch profiles from an arbitrary variable by itself.
AUX_MODE=aux-gpu
